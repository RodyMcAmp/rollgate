# Generated by rollgate update for the trial boot of release {{.Date}} (ADR 0011).
# grub.cfg reads this file. rollgate update arms the entry once with next_entry in
# grubenv; any later boot is the default entry, the system in @.
menuentry 'rollgate update trial ({{.Date}})' --id rollgate-trial {
	insmod part_gpt
	insmod btrfs
	search --no-floppy --fs-uuid --set=root {{.UUID}}
	echo 'Loading the update to {{.Date}} (trial boot) ...'
	linux /@next/boot/vmlinuz-linux root=UUID={{.UUID}} rw rootflags=subvol=@next{{range .Options}} {{.}}{{end}} panic=10
	initrd{{range .Initrds}} /@next/boot/{{.}}{{end}}
}
