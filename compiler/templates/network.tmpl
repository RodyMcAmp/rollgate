{{.Header}}
# {{.Kind}} "{{.Name}}", zone "{{.Zone}}".

[Match]
Name={{.Device}}

[Link]
RequiredForOnline={{if .WAN}}routable{{else}}no{{end}}

[Network]
{{- if .DHCPClient}}
DHCP=ipv4
{{- else}}
Address={{.Addr}}
# Keep the address even with no cable plugged in, so DHCP and DNS can bind to it.
ConfigureWithoutCarrier=yes
{{- end}}
{{- range .VLANs}}
VLAN={{.}}
{{- end}}
{{- if .IPv6Off}}
# system.ipv6 = "off"
LinkLocalAddressing=no
IPv6AcceptRA=no
{{- end}}
{{- if .DHCPClient}}

[DHCPv4]
# The router resolves names itself (Unbound); don't take DNS, domain or
# hostname settings from the ISP.
UseDNS=no
UseDomains=no
UseHostname=no
{{- end}}
