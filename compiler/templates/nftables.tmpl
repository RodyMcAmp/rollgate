{{.Header}}
# Loaded by nftables.service (nft -f /etc/nftables.conf).
#
# Firewall and NAT for IPv4 and IPv6 in one table (ADR 0006). Rules are
# explained in docs/config-spec.md#firewall. Zones and their devices:
{{- range .Zones}}
#   {{.Name}}: {{join .Devices ", "}}
{{- end}}

flush ruleset

table inet rollgate {
	# Traffic to the router itself.
	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iifname "lo" accept

		# Ping and ICMP error messages from every zone, rate-limited.
		meta l4proto icmp limit rate 10/second burst 20 packets accept
		# IPv6 neighbor discovery (IPv6's ARP) and router solicitations. A hop
		# limit of 255 proves they come from the local link.
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit } ip6 hoplimit 255 accept
{{- if not .IPv6Off}}
		# From the ISP: router advertisements and DHCPv6 replies, from its
		# link-local address only, so IPv6 internet can work.
		iifname {{set .WAN}} icmpv6 type nd-router-advert ip6 saddr fe80::/10 ip6 hoplimit 255 accept
		iifname {{set .WAN}} ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
{{- end}}
		meta l4proto ipv6-icmp limit rate 10/second burst 20 packets accept
{{- if .Services}}

		# DHCP and DNS where a [dhcp.<name>] section exists.
		iifname {{set .Services}} udp dport 67 accept
		iifname {{set .Services}} meta l4proto { tcp, udp } th dport 53 accept
{{- end}}

		# SSH, and the web UI (HTTPS, and HTTP that only redirects to it), from
		# management.allowed_zones only (ADR 0014).
		iifname {{set .Management}} tcp dport { 22, 80, 443 } accept
	}

	# Traffic passing through the router.
	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
{{- if .PortForwards}}

		# Port forwards: traffic from WAN that the prerouting chain sent to a device.
		iifname {{set .WAN}} ct status dnat accept
{{- end}}
{{- if .DefaultPolicy}}

		# No [[firewall.policy]] given: every local zone may reach the internet.
{{- else}}

		# [[firewall.policy]], in order. The first matching rule wins.
{{- end}}
{{- range .Policies}}
{{- if .Comment}}
		# {{.Comment}}
{{- end}}
		iifname {{set .From}}{{if .To}} oifname {{set .To}}{{end}} {{.Verdict}}
{{- end}}
	}
{{- if .PortForwards}}

	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
{{- range .PortForwards}}
		# {{.Name}}
		iifname {{set $.WAN}} meta nfproto ipv4 meta l4proto {{list .Protocols}} th dport {{.WANPorts}} dnat ip to {{.Target}}
{{- end}}
	}
{{- end}}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		# Local IPv4 addresses leave as the router's WAN address. IPv6 isn't NATed.
		oifname {{set .WAN}} meta nfproto ipv4 masquerade
	}
}
