{{- define "entry" -}}
menuentry '{{.Title}}' --id {{.ID}} {
	insmod part_gpt
	insmod btrfs
	search --no-floppy --fs-uuid --set=root {{.UUID}}
	echo 'Loading {{.Title}} ...'
	linux /{{.Subvol}}/boot/vmlinuz-linux root=UUID={{.UUID}} rw rootflags=subvol={{.Subvol}}{{range .Options}} {{.}}{{end}}{{if .Panic}} panic=10{{end}}
	initrd{{range .Initrds}} /{{$.Subvol}}/boot/{{.}}{{end}}
}
{{- end -}}
# Generated by rollgate update (ADR 0011). grub.cfg reads this file after its own
# entries. The default entry is always the system in @.
{{- with .Trial}}

# The trial boot of an update. rollgate update arms it once with next_entry in
# grubenv; any later boot is the default entry.
{{template "entry" .}}
{{- end}}
{{- with .Previous}}

# The system before the last update, for booting by hand. rollgate rollback makes
# it the system again.
{{template "entry" .}}
{{- end}}
