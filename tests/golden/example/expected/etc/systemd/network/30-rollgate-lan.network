# Generated by rollgate compile from router.toml (sha256 1d34e59df706dcc1aef118e51e561f0653f42d04730d7c6c293bd2b24d86be8e).
# Do not edit: change router.toml instead (docs/architecture.md#config-flow).
# interface "lan", zone "lan".

[Match]
Name=lan

[Link]
RequiredForOnline=no

[Network]
Address=192.168.10.1/24
# Keep the address even with no cable plugged in, so DHCP and DNS can bind to it.
ConfigureWithoutCarrier=yes
# Local IPv6 (ULA) and, when the ISP delegates a prefix, public IPv6 (ADR 0008).
Address=fd12:3456:789a:10::1/64
IPv6SendRA=yes
DHCPPrefixDelegation=yes
VLAN=iot

[IPv6SendRA]
# The router's local address never changes, so clients' DNS settings never go stale.
EmitDNS=yes
DNS=fd12:3456:789a:10::1
EmitDomains=yes
Domains=home.arpa

[IPv6Prefix]
Prefix=fd12:3456:789a:10::/64

[DHCPPrefixDelegation]
# A public /64 from the ISP's delegated prefix, when there is one.
UplinkInterface=wan
SubnetId=0x10
Announce=yes
Token=::1
