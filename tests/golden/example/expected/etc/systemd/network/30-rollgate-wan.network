# Generated by rollgate compile from router.toml (sha256 1d34e59df706dcc1aef118e51e561f0653f42d04730d7c6c293bd2b24d86be8e).
# Do not edit: change router.toml instead (docs/architecture.md#config-flow).
# interface "wan", zone "wan".

[Match]
Name=wan

[Link]
RequiredForOnline=routable

[Network]
DHCP=yes

[DHCPv4]
# The router resolves names itself (Unbound); don't take DNS, domain or
# hostname settings from the ISP.
UseDNS=no
UseDomains=no
UseHostname=no

[IPv6AcceptRA]
# Always ask for a delegated prefix, even if the ISP's router advertisement
# doesn't mention DHCPv6. Harmless when the ISP offers no IPv6.
DHCPv6Client=always
UseDNS=no
UseDomains=no

[DHCPv6]
PrefixDelegationHint=::/56
UseDNS=no
UseDomains=no
