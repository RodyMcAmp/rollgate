#!/bin/sh
# Prints one line on the console once boot has finished. The L3 tests
# (tests/vm/) parse it; humans at the console can read it too.
#   ROLLGATE_BOOT state=<running|degraded|...> kernel=<uname -r> watchdog=<driver>:<active|inactive> timesync=<active|...> failed=<unit,unit,...>
# watchdog= is /dev/watchdog0's identity (spaces as _), or "none". timesync= is whether
# systemd-timesyncd runs (ADR 0013). failed= stays last.

state=$(systemctl is-system-running --wait)
failed=$(systemctl list-units --failed --plain --no-legend | awk '{print $1}' | paste -sd, -)
wd=/sys/class/watchdog/watchdog0
watchdog=none
if [ -r "$wd/identity" ]; then
  watchdog="$(tr ' ' _ < "$wd/identity"):$(cat "$wd/state" 2>/dev/null || echo unknown)"
fi
timesync=$(systemctl is-active systemd-timesyncd.service)
line="ROLLGATE_BOOT state=$state kernel=$(uname -r) watchdog=$watchdog timesync=$timesync failed=$failed"
echo "$line"

# Test VMs attach a virtio-serial port with this name, so the tests get the line on a
# channel of its own. On the console it can be interleaved with the login prompt's
# terminal codes. Real hardware has no such port.
port=/dev/virtio-ports/org.rollgate.report
if [ -c "$port" ]; then
  echo "$line" > "$port"
fi
