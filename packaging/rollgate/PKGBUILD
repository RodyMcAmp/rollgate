# rollgate itself (docs/build-and-release.md, "Our own packages"): the CLI, its
# systemd units and the health checks. packaging/build.sh builds it from the static
# binary that `make rollgate` produced and the files next to this PKGBUILD; the
# version is the release date (2026-11-16 -> 2026.11.16), so a newer release always
# upgrades it. The image installs it, and routers upgrade it from the signed
# [rollgate] repository (ADR 0012).

pkgname=rollgate
pkgver=${ROLLGATE_PKGVER:?set by packaging/build.sh}
pkgrel=1
pkgdesc="rollgate router OS: router.toml compiler, safe apply, health checks and updates"
arch=(x86_64)
url="https://github.com/RodyMcAmp/rollgate"
license=(Apache-2.0)
# A static Go binary: nothing to strip or split into debug files.
options=(!debug !strip)

package() {
  install -Dm0755 "$startdir/rollgate" "$pkgdir/usr/bin/rollgate"
  install -Dm0644 -t "$pkgdir/usr/lib/systemd/system" \
    "$startdir/rollgate-boot.service" "$startdir/rollgate-health.service" \
    "$startdir/rollgate-api.socket" "$startdir/rollgate-api.service" \
    "$startdir/rollgate-web.socket" "$startdir/rollgate-web.service" \
    "$startdir/rollgate-blocklists.service" "$startdir/rollgate-blocklists.timer"
  # ADR 0019: the DNS blocklists' daily update. With no blocklists set, a run
  # only tidies up and exits.
  install -dm0755 "$pkgdir/usr/lib/systemd/system/timers.target.wants"
  ln -s ../rollgate-blocklists.timer "$pkgdir/usr/lib/systemd/system/timers.target.wants/rollgate-blocklists.timer"
  install -Dm0644 "$startdir/sysusers.conf" "$pkgdir/usr/lib/sysusers.d/rollgate.conf"
  install -Dm0755 -t "$pkgdir/usr/lib/rollgate/health.d" "$startdir"/health.d/*
  # ADR 0013: systemd-timesyncd keeps the clock right, on routers that update too.
  install -dm0755 "$pkgdir/usr/lib/systemd/system/sysinit.target.wants"
  ln -s ../systemd-timesyncd.service "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/systemd-timesyncd.service"
  # ADR 0015: time servers by IP address when names can't be looked up.
  install -Dm0644 "$startdir/timesyncd.conf" "$pkgdir/usr/lib/systemd/timesyncd.conf.d/10-rollgate.conf"
  install -dm0755 "$pkgdir/etc/rollgate"
  install -dm0700 "$pkgdir/etc/rollgate/secrets"
}
