{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Generated by `rollgate schema` from the Go types. Reference: docs/config-spec.md",
  "properties": {
    "dhcp": {
      "additionalProperties": {
        "additionalProperties": false,
        "description": "Hand out addresses on this interface or VLAN.",
        "properties": {
          "lease_time": {
            "description": "How long a lease lasts, e.g. \"12h\" (default).",
            "type": "string"
          },
          "range": {
            "description": "First and last address to hand out.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "static": {
            "description": "Devices that always get the same address.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "hostname": {
                  "description": "Device name; also its local DNS name.",
                  "type": "string"
                },
                "ipv4": {
                  "description": "Address it always gets (outside the range).",
                  "type": "string"
                },
                "mac": {
                  "description": "Device's MAC address.",
                  "type": "string"
                }
              },
              "required": [
                "hostname",
                "mac",
                "ipv4"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "range"
        ],
        "type": "object"
      },
      "description": "DHCP per interface or VLAN: [dhcp.\u003cname\u003e].",
      "type": "object"
    },
    "dns": {
      "additionalProperties": false,
      "description": "How the router resolves names.",
      "properties": {
        "allow": {
          "description": "Names never blocked, with every name under them.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "blocklists": {
          "description": "Names to block on every network: \"recommended\" or https:// URLs of lists (ADR 0019).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "forwarders": {
          "description": "With mode = \"forward\": \"ip\", \"ip@port\" or \"ip@853#tls-name\"; all TLS or none.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mode": {
          "description": "\"recursive\" (default) or \"forward\".",
          "enum": [
            "recursive",
            "forward"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "firewall": {
      "additionalProperties": false,
      "description": "Forwarding rules and port forwards. WAN inbound is always blocked.",
      "properties": {
        "policy": {
          "description": "Zone-to-zone rules, in order; the first match wins.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "description": "What to do with matching traffic.",
                "enum": [
                  "accept",
                  "drop",
                  "reject"
                ],
                "type": "string"
              },
              "comment": {
                "description": "Note for humans.",
                "type": "string"
              },
              "from": {
                "description": "Zone, or \"*\" for every zone except wan.",
                "type": "string"
              },
              "to": {
                "description": "Zone, or \"*\" for every zone.",
                "type": "string"
              }
            },
            "required": [
              "from",
              "to",
              "action"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "port_forward": {
          "description": "Let one service in from the internet.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "description": "Name, e.g. \"game server\".",
                "type": "string"
              },
              "protocol": {
                "description": "Protocol.",
                "enum": [
                  "tcp",
                  "udp",
                  "tcp+udp"
                ],
                "type": "string"
              },
              "to": {
                "description": "Device and port, \"ip:port\".",
                "type": "string"
              },
              "wan_port": {
                "description": "Port on the internet side, or a range \"start-end\".",
                "type": [
                  "integer",
                  "string"
                ]
              }
            },
            "required": [
              "name",
              "protocol",
              "wan_port",
              "to"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "interface": {
      "description": "Physical network ports.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "ipv4": {
            "description": "\"dhcp\" or the router's address with network size, e.g. \"192.168.10.1/24\".",
            "type": "string"
          },
          "ipv6_subnet_id": {
            "description": "Advanced: pins this network's IPv6 /64 number.",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "match_device": {
            "description": "Linux device name of the port, e.g. \"enp1s0\".",
            "type": "string"
          },
          "match_mac": {
            "description": "MAC address of the port (preferred).",
            "type": "string"
          },
          "name": {
            "description": "Name, and zone name unless zone is set.",
            "type": "string"
          },
          "zone": {
            "description": "Zone, if not the same as the name. The zone \"wan\" is the internet side.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "ipv4"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ipv6": {
      "additionalProperties": false,
      "description": "Advanced IPv6 overrides; rarely needed.",
      "properties": {
        "ula_prefix": {
          "description": "A fixed local IPv6 /48 inside fd00::/8.",
          "type": "string"
        },
        "wan_prefix_hint": {
          "description": "Delegated prefix size to ask the ISP for (default 56).",
          "maximum": 64,
          "minimum": 48,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "management": {
      "additionalProperties": false,
      "description": "Who can manage the router.",
      "properties": {
        "allowed_zones": {
          "description": "Zones that can reach SSH and the web UI (default [\"lan\"]). Never \"wan\".",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "confirm_timeout_seconds": {
          "description": "Seconds to confirm a change before it's undone (default 120).",
          "maximum": 900,
          "minimum": 30,
          "type": "integer"
        },
        "ssh_authorized_keys": {
          "description": "Public key files in /etc/rollgate/secrets/ allowed to log in over SSH.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "schema_version": {
      "description": "Format version of this file.",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "system": {
      "additionalProperties": false,
      "description": "Router identity and IPv6.",
      "properties": {
        "domain": {
          "description": "Local DNS domain (default \"home.arpa\").",
          "type": "string"
        },
        "hostname": {
          "description": "The router's name (default \"gateway\").",
          "type": "string"
        },
        "ipv6": {
          "description": "\"auto\": local IPv6 always, IPv6 internet if the ISP offers it. \"off\": no IPv6.",
          "enum": [
            "auto",
            "off"
          ],
          "type": "string"
        },
        "timezone": {
          "description": "IANA timezone name (default \"UTC\").",
          "type": "string"
        }
      },
      "type": "object"
    },
    "vlan": {
      "description": "VLANs on a physical port.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "VLAN number.",
            "maximum": 4094,
            "minimum": 1,
            "type": "integer"
          },
          "ipv4": {
            "description": "\"dhcp\" or the router's address with network size.",
            "type": "string"
          },
          "ipv6_subnet_id": {
            "description": "Advanced: pins this network's IPv6 /64 number.",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "description": "Name, and zone name unless zone is set.",
            "type": "string"
          },
          "parent": {
            "description": "The interface this VLAN runs on.",
            "type": "string"
          },
          "zone": {
            "description": "Zone, if not the same as the name.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "parent",
          "id",
          "ipv4"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "vpn": {
      "additionalProperties": false,
      "description": "A WireGuard VPN for reaching home from outside (ADR 0018). Present means on.",
      "properties": {
        "address": {
          "description": "The router's address inside the VPN (default \"10.66.0.1/24\").",
          "type": "string"
        },
        "endpoint": {
          "description": "A name that always points at your home, for devices' configurations.",
          "type": "string"
        },
        "peer": {
          "description": "Devices allowed to connect.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "ipv4": {
                "description": "The device's address inside the VPN.",
                "type": "string"
              },
              "name": {
                "description": "The device's name.",
                "type": "string"
              },
              "public_key": {
                "description": "The device's WireGuard public key.",
                "type": "string"
              }
            },
            "required": [
              "name",
              "public_key",
              "ipv4"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "port": {
          "description": "UDP port on WAN (default 51820).",
          "type": "integer"
        },
        "reach": {
          "description": "What devices reach: \"everything\" (default) or \"internet\".",
          "enum": [
            "everything",
            "internet"
          ],
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "rollgate router.toml",
  "type": "object"
}
